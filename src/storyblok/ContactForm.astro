---
import { storyblokEditable } from '@storyblok/astro'
import RichText from './utils/RichText.astro'
import Heading from './utils/Heading.astro'
const { blok } = Astro.props

// Web3Forms access keys are public by design (they are embedded in the HTML).
// Set WEB3FORMS_ACCESS_KEY in the Vercel project (and .env locally) so the key
// is not committed to the repository.
const accessKey = import.meta.env.WEB3FORMS_ACCESS_KEY
const successMessage = blok.success || 'Merci, votre message a bien été envoyé. Je vous réponds sous 48h.'

if (!accessKey) {
  console.warn('[ContactForm] WEB3FORMS_ACCESS_KEY is not set: form submissions will fail.')
}
---

<section class="container" {...storyblokEditable(blok)} data-aos="fade-up">
  <div class="max-w-xl mx-auto">
    {
      blok.title && (
        <div class="text-center">
          <RichText content={blok.title} />
        </div>
      )
    }
  </div>

  <div class="mt-12 max-w-lg mx-auto">
    <div class="flex flex-col card card-border rounded-[var(--radius-box)] p-4 sm:p-6 lg:p-8">
      <Heading tag={blok.formTag} classlist="mb-8 text-xl font-semibold" content={blok.formTitle} />

      <form id="contact-form" method="POST" data-success={successMessage}>
        <input type="hidden" name="access_key" value={accessKey} />
        <input type="hidden" name="subject" value="Nouveau message depuis cecilepaulin.fr" />
        <input type="hidden" name="from_name" value="Site Cécile Paulin" />
        <input type="checkbox" name="botcheck" class="hidden" style="display: none;" tabindex="-1" autocomplete="off" />

        <div class="grid gap-4 lg:gap-6">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 lg:gap-6">
            <div>
              <label for="prenom" class="block mb-2 text-sm text-base-content/85 font-medium">Prénom</label>
              <input
                required
                type="text"
                name="prenom"
                id="prenom"
                autocomplete="given-name"
                class="text-accent py-2.5 sm:py-3 px-4 block w-full card card-border rounded-[var(--radius-field)] sm:text-sm focus:border-accent focus:ring-accent disabled:opacity-50 disabled:pointer-events-none"
              />
            </div>

            <div>
              <label for="nom" class="block mb-2 text-sm text-base-content/85 font-medium">Nom</label>
              <input
                required
                type="text"
                name="nom"
                id="nom"
                autocomplete="family-name"
                class="text-accent py-2.5 sm:py-3 px-4 block w-full card card-border rounded-[var(--radius-field)] sm:text-sm focus:border-accent focus:ring-accent disabled:opacity-50 disabled:pointer-events-none"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 lg:gap-6">
            <div>
              <label for="email" class="block mb-2 text-sm text-base-content/85 font-medium">Email</label>
              <input
                required
                type="email"
                name="email"
                id="email"
                autocomplete="email"
                class="text-accent py-2.5 sm:py-3 px-4 block w-full card card-border rounded-[var(--radius-field)] sm:text-sm focus:border-accent focus:ring-accent disabled:opacity-50 disabled:pointer-events-none"
              />
            </div>

            <div>
              <label for="telephone" class="block mb-2 text-sm text-base-content/85 font-medium">
                Numéro de téléphone
              </label>
              <input
                type="tel"
                name="telephone"
                id="telephone"
                autocomplete="tel"
                class="text-accent py-2.5 sm:py-3 px-4 block w-full card card-border rounded-[var(--radius-field)] sm:text-sm focus:border-accent focus:ring-accent disabled:opacity-50 disabled:pointer-events-none"
              />
            </div>
          </div>

          <div>
            <label for="message" class="block mb-2 text-sm text-base-content/85 font-medium">Message</label>
            <textarea
              required
              id="message"
              name="message"
              rows="4"
              class="text-accent py-2.5 sm:py-3 px-4 block w-full card card-border rounded-[var(--radius-field)] sm:text-sm focus:border-accent focus:ring-accent disabled:opacity-50 disabled:pointer-events-none"></textarea>
            <fieldset class="fieldset rounded-box">
              <label class="fieldset-label">
                <input type="checkbox" name="rgpd" value="oui" class="checkbox checkbox-accent" required />
                <span class="p-4 body-sm text-base-content">
                  {blok.rgpd}
                </span>
              </label>
            </fieldset>
          </div>
        </div>

        <div class="mt-6 grid">
          <button type="submit" class="btn btn-accent">Envoyer</button>
        </div>

        <div class="mt-3 text-center text-xs text-base-content/50">
          <RichText content={blok.info} />
        </div>

        <p id="contact-form-result" class="mt-3 text-center text-sm" role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>
<!-- End Contact Us -->

<script>
  const form = document.getElementById('contact-form')
  const result = document.getElementById('contact-form-result')
  const submitButton = form?.querySelector('button[type="submit"]')

  if (form) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault()

      if (!form.reportValidity()) return

      const payload = Object.fromEntries(new FormData(form))
      result.textContent = 'Envoi en cours…'
      result.classList.remove('text-error')
      submitButton?.setAttribute('disabled', 'disabled')

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json'
          },
          body: JSON.stringify(payload)
        })

        const data = await response.json()

        if (response.ok && data.success) {
          result.textContent =
            form.dataset.success || 'Merci, votre message a bien été envoyé. Je vous réponds sous 48h.'
          form.reset()
        } else {
          result.textContent = data.message || 'Une erreur est survenue. Merci de réessayer.'
          result.classList.add('text-error')
        }
      } catch (error) {
        console.error('[ContactForm]', error)
        result.textContent = 'Une erreur est survenue. Merci de réessayer ou de m’appeler.'
        result.classList.add('text-error')
      } finally {
        submitButton?.removeAttribute('disabled')
      }
    })
  }
</script>
