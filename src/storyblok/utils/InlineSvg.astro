---
const { src, class: classList, innerclass, alt, colorize = false } = Astro.props

const escapeAttr = (value) =>
  String(value).replaceAll('&', '&amp;').replaceAll('"', '&quot;').replaceAll('<', '&lt;')

const black = /^(#{3,6}0{3,6}|black|rgb\(\s*0\s*,\s*0\s*,\s*0\s*\))$/i

// Fail silently: a deleted Storyblok asset (404, non-SVG, network error)
// must never break the whole page. Render nothing in those cases.
let innerHTML = ''
try {
  if (typeof src === 'string' && src.trim() !== '') {
    const res = await fetch(src)
    if (res.ok) {
      const text = (await res.text()).trim()
      if (text.includes('<svg')) innerHTML = text
    }
  }
} catch {
  innerHTML = ''
}

if (innerHTML) {
  if (colorize) {
    // Hardcoded blacks ignore the site palette: let them inherit the design colour.
    innerHTML = innerHTML
      .replace(
        /\b(fill|stroke|stop-color|color)=(["'])([^"']*)\2/gi,
        (match, attr, _quote, value) => (black.test(value.trim()) ? `${attr}="currentColor"` : match)
      )
      .replace(/\b(fill|stroke|stop-color|color)\s*:\s*([^;"'}]+)/gi, (match, attr, value) =>
        black.test(value.trim()) ? `${attr}:currentColor` : match
      )
  }

  // Merge our class into the root <svg> instead of adding a second class attribute.
  innerHTML = innerHTML.replace(/<svg\b([^>]*)>/, (_match, attrs) => {
    const withoutClass = attrs.replace(/\sclass\s*=\s*(["'])[^"']*\1/i, '')
    const accessibility = alt
      ? ` role="img" aria-label="${escapeAttr(alt)}"`
      : ' role="presentation" aria-hidden="true" focusable="false"'
    const classAttr = innerclass ? ` class="${innerclass}"` : ''

    return `<svg${classAttr}${withoutClass}${accessibility}>`
  })
}
---

{
  innerHTML && (
    <div class={`fill-current stroke-current ${classList ? classList : ''}`}>
      <Fragment set:html={innerHTML} />
    </div>
  )
}

<style>
  div > :global(svg) {
    max-width: 100%;
    max-height: 100%;
  }
</style>
